# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth - use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Database (MySQL-compatible: local MySQL, PlanetScale, TiDB Cloud, Aiven, Railway, etc.)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=textile_erp
DB_PORT=3306
# Set to "true" if your cloud DB provider requires SSL (most do)
DB_SSL=false

# AI Insights (optional - falls back to rule-based insights if not set)
OPENAI_API_KEY=
